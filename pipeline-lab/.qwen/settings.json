{
  "context": {
    "fileName": ["QWEN.md"]
  },
  "tools": {
    "approvalMode": "yolo"
  },
  "memory": {
    "enableAutoSkill": false
  },
  "model": {
    "maxToolCallsPerTurn": 0,
    "skipLoopDetection": true
  },
  "permissions": {
    "allow": [
      "Read",
      "Bash(python3 *)",
      "Bash(PYTHONPATH=*)",
      "Agent(context-researcher)",
      "Agent(spec-writer)",
      "Agent(routing-analyzer)",
      "Agent(spec-reviewer)",
      "Agent(gap-resolver)",
      "Agent(spec-challenger)",
      "Agent(challenge-resolver)",
      "Agent(code-auditor)",
      "Agent(alignment-resolver)"
    ],
    "deny": [
      "WebFetch",
      "web_search",
      "Edit(/analytics/**)",
      "Write(/analytics/**)",
      "Edit(/repositories/**)",
      "Write(/repositories/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(task|agent)$",
        "hooks": [
          {
            "type": "command",
            "command": ".qwen/hooks/pipeline-before-subagent.sh",
            "name": "pipeline-before-subagent",
            "description": "deny subagent when type != pipeline_delegate active-task",
            "timeout": 30000
          }
        ]
      },
      {
        "matcher": "^(read_file|grep_search|glob|list_directory|run_shell_command)$",
        "hooks": [
          {
            "type": "command",
            "command": ".qwen/hooks/pipeline-box-orchestrator.sh",
            "name": "pipeline-box-orchestrator",
            "description": "deny main-session reads of pipelines/ and router sources",
            "timeout": 10000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".qwen/hooks/pipeline-after-subagent.sh",
            "name": "pipeline-after-subagent",
            "description": "capture routing report + append_run_log + validate for active pipeline task",
            "timeout": 120000
          }
        ]
      }
    ]
  },
  "$version": 4
}
