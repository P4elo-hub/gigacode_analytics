{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigacode.local/music-production/sound-direction.schema.json",
  "title": "Sound direction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "track_id", "created_at",
    "sound_direction_version_id", "structure", "vocal_direction",
    "arrangement", "dynamics", "spatial_direction", "negative_constraints"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "track_id": { "type": "string", "minLength": 1 },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sound_direction_version_id": { "type": "string", "minLength": 1 },
    "structure": { "type": "string", "minLength": 1 },
    "vocal_direction": { "type": "string", "minLength": 1 },
    "arrangement": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "dynamics": { "type": "string", "minLength": 1 },
    "spatial_direction": { "type": "string", "minLength": 1 },
    "negative_constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
