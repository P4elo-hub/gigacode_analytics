{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigacode.local/music-production/defect.schema.json",
  "$comment": "end_seconds > start_seconds is a cross-field invariant and will be checked by the service validator in a later stage.",
  "title": "Defect",
  "description": "One defect on one version. start_seconds and end_seconds are positions inside the audio file, in seconds, not a time of day.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "track_id",
    "created_at",
    "id",
    "version_id",
    "start_seconds",
    "end_seconds",
    "category",
    "importance",
    "diagnosis",
    "preserve",
    "desired_change",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "track_id": { "type": "string", "minLength": 1 },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "id": { "type": "string", "minLength": 1 },
    "version_id": { "type": "string", "minLength": 1 },
    "start_seconds": { "type": "number", "minimum": 0 },
    "end_seconds": { "type": "number", "minimum": 0 },
    "category": { "type": "string", "minLength": 1 },
    "importance": { "type": "string", "minLength": 1 },
    "diagnosis": { "type": "string", "minLength": 1 },
    "preserve": {
      "type": "string",
      "minLength": 1,
      "description": "What to keep."
    },
    "desired_change": {
      "type": "string",
      "minLength": 1,
      "description": "The desired change."
    },
    "status": { "type": "string", "minLength": 1 }
  }
}
