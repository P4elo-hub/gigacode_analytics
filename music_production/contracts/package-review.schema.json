{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigacode.local/music-production/package-review.schema.json",
  "title": "Package review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "track_id", "created_at", "review_id",
    "verdict", "revision_target", "issues", "song_package"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "track_id": { "type": "string", "minLength": 1 },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "review_id": { "type": "string", "minLength": 1 },
    "verdict": { "type": "string", "enum": ["PASS", "REVISE", "BLOCKED"] },
    "revision_target": {
      "type": ["string", "null"],
      "enum": ["LYRICS", "PRODUCTION", null]
    },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    },
    "song_package": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/song_package" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "verdict": { "const": "PASS" } },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "song_package": { "$ref": "#/$defs/song_package" },
          "revision_target": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "verdict": { "const": "REVISE" } },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "revision_target": { "enum": ["LYRICS", "PRODUCTION"] },
          "issues": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": {
          "type": "string",
          "enum": ["INFO", "MINOR", "MAJOR", "CRITICAL"]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "song_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "track_id", "created_at", "version_id",
        "lyrics_version_id", "sound_direction_version_id"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "track_id": { "type": "string", "minLength": 1 },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "version_id": { "type": "string", "minLength": 1 },
        "lyrics_version_id": { "type": "string", "minLength": 1 },
        "sound_direction_version_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
