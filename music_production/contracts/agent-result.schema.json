{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigacode.local/music-production/agent-result.schema.json",
  "title": "Music agent result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "track_id", "created_at", "agent_id", "step",
    "outcome", "artifact_type", "artifact", "issues", "blocked_reason"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "track_id": { "type": "string", "minLength": 1 },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "agent_id": {
      "type": "string",
      "enum": [
        "music-brief-analyst", "music-lyrics-writer", "music-lyrics-editor",
        "music-sound-director", "music-package-reviewer",
        "music-suno-prompt-compiler", "music-candidate-critic",
        "music-defect-diagnostician", "music-revision-planner",
        "music-version-comparator", "music-knowledge-capturer"
      ]
    },
    "step": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "enum": ["PASS", "REVISE", "BLOCKED"] },
    "artifact_type": {
      "type": "string",
      "enum": [
        "brief", "lyrics", "lyrics-review", "sound-direction",
        "package-review", "generation-request", "candidate-review", "defect",
        "revision-plan", "version-comparison", "knowledge-case"
      ]
    },
    "artifact": { "type": ["object", "null"] },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    },
    "blocked_reason": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "PASS" } },
        "required": ["outcome"]
      },
      "then": { "properties": { "artifact": { "type": "object" } } }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "REVISE" } },
        "required": ["outcome"]
      },
      "then": { "properties": { "issues": { "minItems": 1 } } }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "BLOCKED" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "blocked_reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  ],
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": {
          "type": "string",
          "enum": ["INFO", "MINOR", "MAJOR", "CRITICAL"]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
