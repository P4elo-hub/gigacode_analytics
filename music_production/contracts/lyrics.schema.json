{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigacode.local/music-production/lyrics.schema.json",
  "title": "Lyrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "track_id", "created_at", "lyrics_version_id",
    "language", "sections"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "track_id": { "type": "string", "minLength": 1 },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "lyrics_version_id": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "section_type", "text"],
        "properties": {
          "section_id": { "type": "string", "minLength": 1 },
          "section_type": {
            "type": "string",
            "enum": [
              "INTRO", "VERSE", "PRE_CHORUS", "CHORUS", "BRIDGE",
              "HOOK", "OUTRO", "OTHER"
            ]
          },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
