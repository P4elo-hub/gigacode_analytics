{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigacode.local/music-production/edit-attempt.schema.json",
  "title": "Immutable edit attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "track_id",
    "created_at",
    "edit_attempt_id",
    "revision_plan_id",
    "defect_id",
    "parent_version_id",
    "child_version_id",
    "provider_job_id",
    "operation"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "track_id": { "type": "string", "minLength": 1 },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "edit_attempt_id": { "type": "string", "minLength": 1 },
    "revision_plan_id": { "type": "string", "minLength": 1 },
    "defect_id": { "type": "string", "minLength": 1 },
    "parent_version_id": { "type": "string", "minLength": 1 },
    "child_version_id": { "type": "string", "minLength": 1 },
    "provider_job_id": { "type": "string", "minLength": 1 },
    "operation": {
      "type": "string",
      "enum": [
        "generate-batch",
        "regenerate-batch",
        "replace-section",
        "extend",
        "remaster",
        "extract-stems",
        "stem-cover"
      ]
    }
  }
}
