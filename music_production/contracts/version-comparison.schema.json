{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigacode.local/music-production/version-comparison.schema.json",
  "title": "Version comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "track_id", "created_at", "comparison_id",
    "parent_version_id", "child_version_id", "target_defect_id", "outcome",
    "target_defect_resolved", "protected_elements_preserved", "regressions",
    "recommended_current_version_id"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "track_id": { "type": "string", "minLength": 1 },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "comparison_id": { "type": "string", "minLength": 1 },
    "parent_version_id": { "type": "string", "minLength": 1 },
    "child_version_id": { "type": "string", "minLength": 1 },
    "target_defect_id": { "type": "string", "minLength": 1 },
    "outcome": {
      "type": "string",
      "enum": ["ACCEPTED", "PARTIAL", "REJECTED", "BLOCKED"]
    },
    "target_defect_resolved": { "type": "boolean" },
    "protected_elements_preserved": { "type": "boolean" },
    "regressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["INFO", "MINOR", "MAJOR", "CRITICAL"]
          },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recommended_current_version_id": {
      "type": ["string", "null"],
      "minLength": 1
    }
  }
}
