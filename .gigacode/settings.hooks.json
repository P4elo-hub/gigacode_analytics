{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(task|agent)$",
        "hooks": [
          {
            "type": "command",
            "command": ".gigacode/hooks/pipeline-before-subagent.sh",
            "name": "pipeline-before-subagent",
            "description": "deny subagent when type != pipeline_delegate active-task",
            "timeout": 30000
          }
        ]
      },
      {
        "matcher": "^(read_file|grep_search|glob|list_directory|run_shell_command)$",
        "hooks": [
          {
            "type": "command",
            "command": ".gigacode/hooks/pipeline-box-orchestrator.sh",
            "name": "pipeline-box-orchestrator",
            "description": "deny main-session reads of pipelines/ and router sources",
            "timeout": 10000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(context-researcher|routing-analyzer|spec-writer|spec-reviewer|gap-resolver|spec-challenger|challenge-resolver|code-auditor|alignment-resolver|review-capturer|regression-analyst|calibration-proposer|calibration-applier|benchmark-runner|music-brief-analyst|music-lyrics-writer|music-lyrics-editor|music-sound-director|music-package-reviewer|music-suno-prompt-compiler|music-candidate-critic|music-defect-diagnostician|music-revision-planner|music-version-comparator|music-knowledge-capturer)$",
        "hooks": [
          {
            "type": "command",
            "command": ".gigacode/hooks/pipeline-after-subagent.sh",
            "name": "pipeline-after-subagent",
            "description": "append_run_log + ingest + validate after pipeline subagent",
            "timeout": 120000
          }
        ]
      }
    ]
  }
}
