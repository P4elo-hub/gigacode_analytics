{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(task|agent)$",
        "hooks": [
          {
            "type": "command",
            "command": ".gigacode/hooks/pipeline-before-subagent.sh",
            "name": "pipeline-before-subagent",
            "description": "deny subagent when type != pipeline_delegate active-task",
            "timeout": 30000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(context-researcher|spec-writer|spec-reviewer|gap-resolver|spec-challenger|challenge-resolver|code-auditor|alignment-resolver|review-capturer|regression-analyst|calibration-proposer|calibration-applier|benchmark-runner)$",
        "hooks": [
          {
            "type": "command",
            "command": ".gigacode/hooks/pipeline-after-subagent.sh",
            "name": "pipeline-after-subagent",
            "description": "append_run_log + ingest + validate after pipeline subagent",
            "timeout": 120000
          }
        ]
      }
    ]
  }
}
