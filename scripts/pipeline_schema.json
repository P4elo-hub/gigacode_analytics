      "orchestrator": "spec-orchestrator",
      "nodes": [
        {
          "id": "spec-orchestrator",
          "label": "spec-orchestrator",
          "kind": "orchestrator"
        },
        {
          "id": "find-context",
          "label": "find-context",
          "subagent": "context-researcher",
          "kind": "step"
        },
        {
          "id": "write-feature",
          "label": "write-feature",
          "subagent": "spec-writer",
          "kind": "step",
          "cycle": {
            "persistent": true,
            "assemble": "write_feature",
            "param": "block_id",
            "folder": "Feature-writing/{slug}",
            "out": "{slug}.md",
            "item_file": "{slug}.part-{param}.md",
            "close": "on_done"
          }
        },
        {
          "id": "analyze-routing",
          "label": "analyze-routing",
          "subagent": "routing-analyzer",
          "kind": "step"
        },
        {
          "id": "check-feature",
          "label": "check-feature",
          "subagent": "spec-reviewer",
          "kind": "step"
        },
        {
          "id": "resolve-gaps",
          "label": "resolve-gaps",
          "subagent": "gap-resolver",
          "kind": "step",
          "ask": true
        },
        {
          "id": "challenge-feature",
          "label": "challenge-feature",
          "subagent": "spec-challenger",
          "kind": "step"
        },
        {
          "id": "resolve-challenges",
          "label": "resolve-challenges",
          "subagent": "challenge-resolver",
          "kind": "step",
          "ask": true
        },
        {
          "id": "check-feature-code",
          "label": "check-feature-code",
          "subagent": "code-auditor",
          "kind": "step"
        },
        {
          "id": "resolve-code-alignment",
          "label": "resolve-code-alignment",
          "subagent": "alignment-resolver",
          "kind": "step",
          "ask": true
        },
        {
          "id": "archive-session",
          "label": "archive-session",
          "subagent": null,
          "kind": "meta"
        },
        {
          "id": "done",
          "label": "PASS",
          "kind": "terminal"
        }
      ],
      "edges": [
        {
          "id": "e-start",
          "from": "spec-orchestrator",
          "to": "find-context",
          "kind": "main",
          "condition": "not_has_context"
