        {
          "id": "e-cf-cc",
          "from": "check-feature",
          "to": "check-feature-code",
          "kind": "main",
          "label": "after gaps/ch"
        },
        {
          "id": "e-ch-rc",
          "from": "challenge-feature",
          "to": "resolve-challenges",
          "kind": "main"
        },
        {
          "id": "e-ch-ar",
          "from": "challenge-feature",
          "to": "analyze-routing",
          "kind": "loop",
          "label": "refresh after mutate"
        },
        {
          "id": "e-rc-cf",
          "from": "resolve-challenges",
          "to": "check-feature",
          "kind": "loop",
          "condition": "needs_check_feature"
        },
        {
          "id": "e-rc-ar",
          "from": "resolve-challenges",
          "to": "analyze-routing",
          "kind": "loop",
          "label": "refresh after mutate"
        },
        {
          "id": "e-cc-cf",
          "from": "check-feature-code",
          "to": "check-feature",
          "kind": "loop",
          "label": "spec edited after audit",
          "condition": "needs_check_feature"
        },
        {
          "id": "e-cc-rg",
          "from": "check-feature-code",
          "to": "resolve-gaps",
          "kind": "branch",
          "label": "new GAP after audit"
        },
        {
          "id": "e-cc-ra",
          "from": "check-feature-code",
          "to": "resolve-code-alignment",
          "kind": "branch",
          "label": "alignment gaps"
        },
        {
          "id": "e-cc-ar",
          "from": "check-feature-code",
          "to": "analyze-routing",
          "kind": "loop",
          "label": "refresh after mutate"
        },
        {
          "id": "e-ra-cc",
          "from": "resolve-code-alignment",
          "to": "check-feature-code",
          "kind": "loop",
          "label": "re-audit"
        },
        {
          "id": "e-ra-cf",
          "from": "resolve-code-alignment",
          "to": "check-feature",
          "kind": "loop",
          "label": "SPEC edited per alignment",
