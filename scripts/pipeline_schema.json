        },
        {
          "id": "e-ra-ar",
          "from": "resolve-code-alignment",
          "to": "analyze-routing",
          "kind": "loop",
          "label": "refresh after mutate"
        },
        {
          "id": "e-ar-fc",
          "from": "analyze-routing",
          "to": "find-context",
          "kind": "branch",
          "label": "next by dispatch"
        },
        {
          "id": "e-ar-wf",
          "from": "analyze-routing",
          "to": "write-feature",
          "kind": "branch",
          "label": "next by dispatch"
        },
        {
          "id": "e-ar-cf",
          "from": "analyze-routing",
          "to": "check-feature",
          "kind": "main",
          "label": "spec needs review",
          "condition": "needs_check_feature"
        },
        {
          "id": "e-ar-rg",
          "from": "analyze-routing",
          "to": "resolve-gaps",
          "kind": "branch",
          "label": "next by dispatch"
        },
        {
          "id": "e-ar-ch",
          "from": "analyze-routing",
          "to": "challenge-feature",
          "kind": "branch",
          "label": "next by dispatch"
        },
        {
          "id": "e-ar-rc",
          "from": "analyze-routing",
          "to": "resolve-challenges",
          "kind": "branch",
          "label": "next by dispatch"
        },
        {
          "id": "e-ar-cc",
          "from": "analyze-routing",
          "to": "check-feature-code",
          "kind": "branch",
          "label": "next by dispatch"
        },
        {
          "id": "e-ar-ra",
          "from": "analyze-routing",
          "to": "resolve-code-alignment",
          "kind": "branch",
          "label": "next by dispatch"
        },
        {
          "id": "e-ar-done",
          "from": "analyze-routing",
          "to": "done",
          "kind": "branch",
          "label": "ready"
        },
        {
          "id": "e-cc-done",
          "from": "check-feature-code",
          "to": "done",
          "kind": "main",
          "label": "PASS",
          "condition": "alignment_pass"
        }
      ]
