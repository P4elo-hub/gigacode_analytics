        {
          "id": "e-orch-ar",
          "from": "spec-orchestrator",
          "to": "analyze-routing",
          "kind": "branch",
          "label": "routing-state missing/stale",
          "condition": "routing_state_needs_refresh"
        },
        {
          "id": "e-fc-wf",
          "from": "find-context",
          "to": "write-feature",
          "kind": "main"
        },
        {
          "id": "e-fc-ar",
