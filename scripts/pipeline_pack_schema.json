{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigacode.local/pipeline_pack.schema.json",
  "title": "Pipeline pack authoring payload",
  "description": "Authoring JSON contract for --from-json and UI editors. Runtime validates a subset of this schema in pipeline_pack_authoring.validate_pack_json (no jsonschema dependency). Compile (when:/agents) is a second layer. YAML on disk is the on-disk form of this object.",
  "type": "object",
  "required": ["id", "graph", "status", "registry"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Pipeline id = folder name pipelines/<id>/. kebab-case."
    },
    "pipeline_id": {
      "type": "string",
      "description": "Alias for id. Normalized to id before write."
    },
    "graph": {
      "type": "object",
      "required": ["label", "orchestrator", "nodes", "edges"],
      "additionalProperties": true,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "orchestrator": { "type": "string", "minLength": 1 },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "kind": { "type": "string" },
              "subagent": { "type": ["string", "null"] },
              "ask": {
                "type": "boolean",
                "description": "This step may pause for a human: ask → same-agent apply, no routing. Overlay ask_user_when still counts the questions."
              },
              "cycle": {
                "type": "object",
                "description": "Composite graph cell: inner agent+param steps, assemble without routing, then close like any node.",
                "additionalProperties": true,
                "properties": {
                  "persistent": { "type": "boolean" },
                  "assemble": { "type": "string" },
                  "param": { "type": "string" },
                  "folder": { "type": "string" },
                  "out": { "type": "string" },
                  "item_file": { "type": "string" },
                  "close": {
                    "type": "string",
                    "enum": ["on_done"],
                    "description": "Exit: stamp graph position and drop the active-task marker, then outer dispatch. Engine default on_done."
                  },
                  "calls": {
                    "type": "array",
                    "description": "Static inner steps {agent, param}. Omitted → adapter fills at runtime (write-feature catalog).",
                    "items": {
                      "type": "object",
                      "properties": {
                        "agent": { "type": "string" },
                        "param": { "type": "string" },
                        "skills": { "type": "array" },
                        "check": { "type": "object" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string" },
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 },
              "kind": { "type": "string" },
              "label": { "type": "string" },
              "condition": {
                "type": "string",
                "description": "edge_conditions key (when: id). PlantUML label maps to this id or auto-slug."
              },
              "condition_label": {
                "type": "string",
                "description": "Human text from PlantUML / UI; codegen may slug this into condition."
              },
              "conditions": {
                "type": "array",
                "description": "All when: ids on this arrow. First is also written as condition.",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "dispatch": {
      "type": "object",
      "description": "Optional. Empty rules/invariants → no compiled router (calibration-style).",
      "additionalProperties": true,
      "properties": {
        "invariant_after_priority": { "type": "integer" },
        "invariants": { "type": "array" },
        "rules": { "type": "array" },
        "fallback": { "type": "object" }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "task_kind": { "type": "string" },
        "collector_mode": {
          "type": "string",
          "description": "routing_state = overlay JSON is the live domain-field source (Phase 12 spec)."
        },
        "artifacts": { "type": "object" },
        "collectors": { "type": "array" },
        "stale": { "type": "array" },
        "invariants": { "type": "array" },
        "orchestrator": { "type": "object" },
        "messages": { "type": "object" },
        "constants": { "type": "object" },
        "display": { "type": "object" },
        "core_predicates": { "type": "object" }
      }
    },
    "routing_conditions": {
      "type": "object",
      "description": "Optional. Phase 13 SSOT: analyzer status_fields + edge_conditions (expr + dispatch). Packs without routing-state omit this block.",
      "additionalProperties": true,
      "properties": {
        "schema_version": { "type": "integer" },
        "status_fields": { "type": "object" },
        "edge_conditions": { "type": "object" },
        "stale_vs": { "type": "array", "items": { "type": "string" } },
        "validate_ids": { "type": "array", "items": { "type": "string" } },
        "overlay": { "type": "object" },
        "when_to_run_analyzer": { "type": "array" },
        "engine_fields": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Status attrs set by the engine, not the analyzer. Expr may reference them."
        },
        "artifact": { "type": "object" },
        "analyzer": { "type": "object" },
        "not_in_dispatch": { "type": "array" },
        "router_owned": { "type": "array" }
      }
    },
    "registry": {
      "type": "object",
      "required": [
        "step_to_subagent",
        "orchestrator_owned",
        "gated_subagents",
        "restartable_steps"
      ],
      "additionalProperties": true,
      "properties": {
        "step_to_subagent": { "type": "object" },
        "orchestrator_owned": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gated_subagents": {
          "type": "array",
          "items": { "type": "string" }
        },
        "restartable_steps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "delegate_modes": { "type": "object" }
      }
    }
  }
}
