  "dispatch": {
    "spec-v2": {
      "invariant_after_priority": 0,
      "invariants": [],
      "fallback": {
        "next": "analyze-routing",
        "reason": "routing-state не готов"
      },
      "rules": [
        {
          "when": "routing_state_needs_refresh",
          "priority": 5,
          "next": "analyze-routing"
        },
        {
          "when": "find_context",
          "priority": 110,
          "next": "context-researcher"
        },
        {
          "when": "has_kontekst_uzhe_est_a_feature_writing_slug_slug_md_esh",
          "priority": 170,
          "next": "spec-writer"
        },
        {
          "when": "has_spec_est_i_posle_poslednei_pravki_eshche_ne_bylo_usp",
          "priority": 180,
          "next": "spec-reviewer"
        },
        {
          "when": "has_v_decisions_est_needs_answer_s_relates_na_gap_open_g",
          "priority": 190,
          "next": "gap-resolver"
        },
        {
          "when": "has_resheniya_po_gap_uzhe_est_nuzhno_primenit_v_spec",
          "priority": 200,
          "next": "gap-resolver"
        },
        {
          "when": "has_open_gaps_ne_pustye_posle_revyu_bez_pending_apply",
          "priority": 210,
          "next": "gap-resolver"
        },
        {
          "when": "has_faila_slug_challenges_md_eshche_net_gaps_zakryty_che",
          "priority": 215,
          "next": "spec-challenger"
        },
        {
          "when": "has_v_decisions_est_needs_answer_s_relates_na_ch",
          "priority": 220,
          "next": "challenge-resolver"
        },
        {
          "when": "has_resheniya_po_ch_uzhe_est_nuzhno_primenit_v_spec",
          "priority": 225,
          "next": "challenge-resolver"
        },
        {
          "when": "has_est_fail_challenges_i_challenges_open_0",
          "priority": 230,
          "next": "challenge-resolver"
        },
        {
          "when": "has_net_otcheta_ili_on_ustarel_korotko_alignment_net_ili",
          "priority": 240,
          "next": "code-auditor"
        },
        {
          "when": "has_otchet_est_no_bez_pass_korotko_alignment_bez_pass_pa",
          "priority": 250,
          "next": "code-auditor"
        },
        {
          "when": "has_v_alignment_est_critical_major_raskhozhdeniya_otchet",
          "priority": 260,
          "next": "alignment-resolver"
        },
        {
          "when": "has_alignment_svezhii_verdict_pass_ili_pass_with_gaps_sp",
          "priority": 300,
          "next": null,
          "outcome": "ready"
        }
      ]
    }
