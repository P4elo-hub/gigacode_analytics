{
  "step_to_subagent": {
    "find-context": "context-researcher",
    "check-feature": "spec-reviewer",
    "resolve-gaps": "gap-resolver",
    "challenge-feature": "spec-challenger",
    "resolve-challenges": "challenge-resolver",
    "check-feature-code": "code-auditor",
    "resolve-code-alignment": "alignment-resolver"
  },
  "orchestrator_owned": [
    "write-feature"
  ],
  "gated_subagents": [
    "context-researcher",
    "spec-writer",
    "spec-reviewer",
    "gap-resolver",
    "spec-challenger",
    "challenge-resolver",
    "code-auditor",
    "alignment-resolver"
  ],
  "restartable_steps": [
    "find-context",
    "write-feature",
    "check-feature",
    "resolve-gaps",
    "challenge-feature",
    "resolve-challenges",
    "check-feature-code",
    "resolve-code-alignment"
  ],
  "step_order": {
    "find-context": 0,
    "write-feature": 1,
    "check-feature": 2,
    "resolve-gaps": 3,
    "challenge-feature": 4,
    "resolve-challenges": 5,
    "check-feature-code": 6,
    "resolve-code-alignment": 7
  },
  "nodes": {
    "calibration": [
      {
        "id": "calibration-orchestrator",
        "label": "calibration-orchestrator",
        "kind": "orchestrator",
        "subagent": null
      },
      {
        "id": "snapshot-baseline",
        "label": "snapshot-baseline",
        "kind": "step",
        "subagent": null
      },
      {
        "id": "capture-review",
        "label": "capture-review",
        "kind": "step",
        "subagent": "review-capturer"
      },
      {
        "id": "analyze-delta",
        "label": "analyze-delta",
        "kind": "step",
        "subagent": "regression-analyst"
      },
      {
        "id": "analyze-telemetry",
        "label": "analyze-telemetry",
        "kind": "step",
        "subagent": "session-telemetry-analyst"
      },
      {
        "id": "propose-calibration",
        "label": "propose-calibration",
        "kind": "step",
        "subagent": "calibration-proposer"
      },
      {
        "id": "apply-calibration",
        "label": "apply-calibration",
        "kind": "step",
        "subagent": "calibration-applier"
      },
      {
        "id": "benchmark-rerun",
        "label": "benchmark-rerun",
        "kind": "step",
        "subagent": "benchmark-runner"
      },
      {
        "id": "cal-done",
        "label": "Scorecard",
        "kind": "terminal",
        "subagent": null
      }
    ],
    "spec": [
      {
        "id": "spec-orchestrator",
        "label": "spec-orchestrator",
        "kind": "orchestrator",
        "subagent": null
      },
      {
        "id": "find-context",
        "label": "find-context",
        "kind": "step",
        "subagent": "context-researcher"
      },
      {
        "id": "write-feature",
        "label": "write-feature",
        "kind": "step",
        "subagent": "spec-writer"
      },
      {
        "id": "check-feature",
        "label": "check-feature",
        "kind": "step",
        "subagent": "spec-reviewer"
      },
      {
        "id": "resolve-gaps",
        "label": "resolve-gaps",
        "kind": "step",
        "subagent": "gap-resolver"
      },
      {
        "id": "challenge-feature",
        "label": "challenge-feature",
        "kind": "step",
        "subagent": "spec-challenger"
      },
      {
        "id": "resolve-challenges",
        "label": "resolve-challenges",
        "kind": "step",
        "subagent": "challenge-resolver"
      },
      {
        "id": "check-feature-code",
        "label": "check-feature-code",
        "kind": "step",
        "subagent": "code-auditor"
      },
      {
        "id": "resolve-code-alignment",
        "label": "resolve-code-alignment",
        "kind": "step",
        "subagent": "alignment-resolver"
      },
      {
        "id": "archive-session",
        "label": "archive-session",
        "kind": "meta",
        "subagent": null
      },
      {
        "id": "done",
        "label": "PASS",
        "kind": "terminal",
        "subagent": null
      }
    ]
  },
  "dispatch": {
    "spec": {
      "invariant_after_priority": 30,
      "invariants": [
        {
          "id": "needs-check-feature",
          "step": "check-feature"
        }
      ],
      "fallback": {
        "next": "check-feature-code",
        "reason": "alignment без PASS / PASS WITH GAPS"
      },
      "rules": [
        {
          "priority": 10,
          "when": "alignment_limit_exhausted",
          "next": null,
          "outcome": "stopped"
        },
        {
          "priority": 20,
          "when": "not_has_context",
          "next": "find-context"
        },
        {
          "priority": 30,
          "when": "not_has_spec",
          "next": "write-feature"
        },
        {
          "priority": 40,
          "when": "needs_answer_with_gaps",
          "next": "resolve-gaps"
        },
        {
          "priority": 45,
          "when": "needs_answer_alignment_only",
          "next": "resolve-code-alignment"
        },
        {
          "priority": 50,
          "when": "needs_answer_challenges_only",
          "next": "resolve-challenges"
        },
        {
          "priority": 60,
          "when": "pending_apply_with_gaps",
          "next": "resolve-gaps"
        },
        {
          "priority": 65,
          "when": "pending_apply_alignment_only",
          "next": "resolve-code-alignment"
        },
        {
          "priority": 70,
          "when": "pending_apply_challenges_only",
          "next": "resolve-challenges"
        },
        {
          "priority": 80,
          "when": "critical_major_mismatch_resolvable",
          "next": "resolve-code-alignment"
        },
        {
          "priority": 90,
          "when": "open_gaps",
          "next": "resolve-gaps"
        },
        {
          "priority": 100,
          "when": "open_challenges",
          "next": "resolve-challenges"
        },
        {
          "priority": 110,
          "when": "no_challenges_file",
          "next": "challenge-feature"
        },
        {
          "priority": 120,
          "when": "alignment_missing_or_stale",
          "next": "check-feature-code"
        },
        {
          "priority": 130,
          "when": "alignment_pass",
          "next": null,
          "outcome": "ready"
        },
        {
          "priority": 140,
          "when": "alignment_fail_reaudit",
          "next": "check-feature-code"
        }
      ]
    }
  },
  "status": {
    "calibration": {
      "task_kind": "slug",
      "artifacts": {},
      "collectors": [],
      "stale": [],
      "orchestrator": {},
      "messages": {
        "ready": "Calibration pack has no dispatch rules.",
        "stopped": "Calibration пайплайн остановлен."
      },
      "invariants": [],
      "display": {},
      "constants": {}
    },
    "spec": {
      "task_kind": "slug",
      "constants": {
        "alignment_max_iterations": "3",
        "verdict_pass": "PASS",
        "verdict_pass_with_gaps": "PASS WITH GAPS",
        "verdict_fail": "FAIL"
      },
      "core_predicates": {
        "counters": [
          {
            "field": "decisions_needs_answer",
            "gt": "0",
            "alias": "field_gt"
          },
          {
            "field": "decisions_pending_apply",
            "gt": "0",
            "alias": "pending_apply"
          }
        ]
      },
      "artifacts": {
        "context": {
          "path": "Feature-context/{task_id}.md",
          "exists_as": "has_context",
          "lines_as": "context_lines",
          "missing_reason": "нет проверенного контекста"
        },
        "spec": {
          "path": "Feature-writing/{task_id}/{task_id}.md",
          "exists_as": "has_spec",
          "lines_as": "spec_lines",
          "missing_reason": "спецификация не написана"
        },
        "decisions": {
          "path": "Feature-writing/{task_id}/{task_id}-decisions.md",
          "exists_as": "has_decisions"
        },
        "gaps_map": {
          "path": "Feature-writing/{task_id}/{task_id}-gaps-resolved.md",
          "exists_as": "has_gaps_map"
        },
        "challenges": {
          "path": "Feature-writing/{task_id}/{task_id}-challenges.md",
          "exists_as": "has_challenges"
        },
        "challenges_map": {
          "path": "Feature-writing/{task_id}/{task_id}-challenges-resolved.md",
          "exists_as": "has_challenges_map"
        },
        "alignment": {
          "path": "Feature-writing/{task_id}/{task_id}-code-alignment.md",
          "exists_as": "has_alignment"
        }
      },
      "collectors": [
        {
          "id": "decisions_table",
          "source": "decisions"
        },
        {
          "id": "spec_gaps",
          "source": "spec"
        },
        {
          "id": "context_questions",
          "source": "context"
        },
        {
          "id": "challenges_table",
          "source": "challenges"
        },
        {
          "id": "alignment_frontmatter",
          "source": "alignment"
        },
        {
          "id": "needs_check_feature",
          "source": "spec"
        }
      ],
      "stale": [
        {
          "id": "alignment",
          "when": "artifact_older_than",
          "left": "alignment",
          "right": "spec"
        },
        {
          "id": "challenges",
          "when": "artifact_older_than",
          "left": "challenges",
          "right": "spec"
        },
        {
          "id": "context-newer-than-spec",
          "when": "artifact_newer_than",
          "left": "context",
          "right": "spec"
        }
      ],
      "alignment_stale": {
        "when": "artifact_older_than",
        "left": "alignment",
        "right": "spec",
        "require_left": true
      },
      "invariants": [
        {
          "id": "needs-check-feature",
          "collector": "needs_check_feature"
        }
      ],
      "orchestrator": {
        "write_cycle_step": "write-feature",
        "ask_user_when": "decisions_needs_answer"
      },
      "messages": {
        "ready": "Spec готов — финальный ответ пользователю.",
        "stopped": "Пайплайн остановлен.",
        "ask_user": "НЕ вызывай task. Прочитай DECISIONS → ask_user_question по needs-answer.",
        "write_cycle": "Цикл write-feature (spec-writer по блокам)."
      },
      "display": {
        "heading": "Фича: {slug}",
        "rows": [
          {
            "label": "CONTEXT_DOC",
            "exists": "has_context",
            "suffix": "{context_lines} строк"
          },
          {
            "label": "SPEC",
            "exists": "has_spec",
            "suffix": "{spec_lines} строк"
          },
          {
            "label": "DECISIONS",
            "exists": "has_decisions",
            "suffix": "ask {decisions_needs_answer} · apply {decisions_pending_apply}"
          },
          {
            "label": "GAPS_MAP",
            "exists": "has_gaps_map"
          },
          {
            "label": "CHALLENGES",
            "exists": "has_challenges",
            "suffix": "open {challenges_open}"
          },
          {
            "label": "CHALLENGES_MAP",
            "exists": "has_challenges_map"
          },
          {
            "label": "ALIGNMENT",
            "exists": "has_alignment",
            "present_format": "✅ итерация {alignment_iteration}/{alignment_max_iterations}",
            "absent_format": "❌"
          }
        ]
      }
    }
  },
