      "has_context",
      "has_decisions",
      "has_gaps_map",
      "has_spec",
      "needs_answer_alignment_only",
      "needs_answer_challenges_only",
      "needs_answer_with_gaps",
      "no_challenges_file",
      "not_has_alignment",
      "not_has_challenges",
      "not_has_challenges_map",
      "not_has_context",
      "not_has_decisions",
      "not_has_gaps_map",
      "not_has_spec",
      "open_challenges",
